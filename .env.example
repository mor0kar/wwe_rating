# Vercel Supabase — wird automatisch von der Vercel-Supabase-Integration gesetzt
# Alternativ manuell aus dem Vercel Dashboard (Project → Storage → Connect)
POSTGRES_URL=postgres://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x

# PIN für die App — z.B. 1312
APP_PIN=DEIN_PIN_HIER

# Discord-Webhook für Benachrichtigungen (Channel → Einstellungen → Integrationen → Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Secret zum Schützen der Cron-Route. Vercel sendet es automatisch als
# "Authorization: Bearer <CRON_SECRET>", wenn die Env-Var gesetzt ist.
CRON_SECRET=ein-langes-zufaelliges-secret
